  "item": [
    {
      "name": "01 - Création valide d'un endroit (201 Created + Location)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Location header is present\", function () {",
              "    pm.response.to.have.header(\"Location\");",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json).to.have.property(\"id\");",
              "pm.expect(json).to.not.have.property(\"_id\");",
              "pm.expect(json).to.not.have.property(\"__v\");",
              "pm.collectionVariables.set(\"placeId\", json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bibliothèque des sciences\",\n  \"description\": \"Espace d'étude silencieux avec bureaux individuels et prises.\",\n  \"category\": \"LIBRARY\",\n  \"address\": \"Pavillon B, local B-210\",\n  \"services\": [\"WIFI\", \"POWER_OUTLETS\"],\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/places",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "places"
          ]
        }
      },
      "description": "Scénario vidéo 1 : Création valide. Doit retourner 201 Created, en-tête Location avec l'URL du nouvel endroit, et le corps sans _id ni __v (id string exposé)."
    },
    {
      "name": "02 - Lecture de la ressource persistée (200 OK + MongoDB)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.test(\"Place corresponds to created resource\", function () {",
              "    pm.expect(json.id).to.eql(pm.collectionVariables.get(\"placeId\"));",
              "    pm.expect(json.name).to.eql(\"Bibliothèque des sciences\");",
              "    pm.expect(json.averageRating).to.be.null;",
              "    pm.expect(json.reviewCount).to.eql(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/places/{{placeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "places",
            "{{placeId}}"
          ]
        }
      },
      "description": "Scénario vidéo 2 : Consultation de la ressource persistée. À montrer également dans MongoDB Compass ou mongosh."
    },
