              "pm.test(\"Location header is present\", function () {",
              "    pm.response.to.have.header(\"Location\");",
              "});",
              "var json = pm.response.json();",
              "pm.collectionVariables.set(\"reviewId\", json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"authorName\": \"Samira\",\n  \"rating\": 5,\n  \"comment\": \"Super endroit pour étudier en toute tranquillité.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/places/{{placeId}}/reviews",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "places",
            "{{placeId}}",
            "reviews"
          ]
        }
      },
      "description": "Publier une appréciation valide : 201 Created, en-tête Location et variable reviewId mémorisée."
    },
    {
      "name": "05 - Lister les appréciations de l'endroit (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(Array.isArray(json)).to.be.true;",
              "    pm.expect(json.length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/places/{{placeId}}/reviews",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "places",
            "{{placeId}}",
            "reviews"
          ]
        }
      },
      "description": "Lister les appréciations de l'endroit : 200 OK, tableau des appréciations de l'endroit."
    },
    {
      "name": "06 - Modifier partiellement un endroit (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Updated field changed\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.description).to.eql(\"Espace rénové avec prises rapides et tables individuelles\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Espace rénové avec prises rapides et tables individuelles\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/places/{{placeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "places",
            "{{placeId}}"
          ]
        }
      },
      "description": "Modifier partiellement l'endroit : 200 OK, seuls les champs envoyés sont modifiés et updatedAt est rafraîchi."
    },
    {
      "name": "07 - Filtrer et paginer les endroits (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Has data and pagination objects\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"data\");",
              "    pm.expect(json).to.have.property(\"pagination\");",
              "    pm.expect(json.pagination.page).to.eql(1);",
              "    pm.expect(json.pagination.limit).to.eql(10);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/places?category=LIBRARY&page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "places"
          ],
          "query": [
            {
              "key": "category",
              "value": "LIBRARY"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "description": "Filtrer par catégorie et paginer : 200 OK, enveloppe data et pagination (page, limit, totalItems, totalPages)."
    },
