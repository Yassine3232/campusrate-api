    },
    {
      "name": "10 - Suppression permise, ressource inexistante et persistance après redémarrage",
      "description": "Étape 10a : supprimer un endroit qui ne possède plus d'appréciation, réponse 204 No Content avec un corps vide. Étape 10b : la ressource est maintenant inexistante, réponse 404 Not Found au format application/problem+json. Persistance : redémarrer le serveur (Ctrl+C puis npm run start) et relancer la requête 07 ; les endroits conservés doivent toujours être présents dans le fichier DATA_FILE_PATH.",
      "item": [
        {
          "name": "10a - Suppression permise de l'endroit (204 No Content)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "pm.test(\"Body is empty\", function () {",
                  "    pm.expect(pm.response.text()).to.eql(\"\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/places/{{placeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "places",
                "{{placeId}}"
              ]
            }
          },
          "description": "Suppression acceptée parce que l'endroit ne possède plus d'appréciation."
        },
        {
          "name": "10b - Ressource inexistante (404 Not Found + Problem Details)",
          "description": "Même URI que 10a après suppression : 404 Not Found avec les cinq champs Problem Details.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Content-Type is problem+json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "});",
                  "pm.test(\"Problem Details fields are present\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"type\");",
                  "    pm.expect(json).to.have.property(\"title\");",
                  "    pm.expect(json).to.have.property(\"status\");",
                  "    pm.expect(json).to.have.property(\"detail\");",
                  "    pm.expect(json).to.have.property(\"instance\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/places/{{placeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "places",
                "{{placeId}}"
              ]
            }
