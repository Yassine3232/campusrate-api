{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
    "name": "CampusRate API",
    "description": "Collection de tests manuels pour l'API REST CampusRate (TP1). Dix scénarios couvrent la création et la consultation des deux concepts, une modification partielle, une suppression permise, une note invalide, une ressource inexistante, un conflit de suppression, le filtre, la pagination, une erreur Problem Details et la persistance après redémarrage.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "placeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reviewId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Créer un endroit (201 Created + Location)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Location header is present\", function () {",
              "    pm.response.to.have.header(\"Location\");",
              "});",
              "var json = pm.response.json();",
              "pm.collectionVariables.set(\"placeId\", json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bibliothèque des sciences\",\n  \"description\": \"Espace d'étude silencieux avec bureaux individuels\",\n  \"category\": \"LIBRARY\",\n  \"address\": \"Pavillon B, local B-210\",\n  \"services\": [\"WIFI\", \"POWER_OUTLETS\"],\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/places",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "places"
          ]
        }
      },
      "description": "Créer un endroit valide : 201 Created, en-tête Location et variable placeId mémorisée."
    },
    {
      "name": "02 - Consulter un endroit par ID (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"averageRating is null initially\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.averageRating).to.be.null;",
              "    pm.expect(json.reviewCount).to.eql(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/places/{{placeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "places",
            "{{placeId}}"
          ]
        }
      },
      "description": "Consulter l'endroit créé : 200 OK, averageRating à null et reviewCount à 0 tant qu'aucune appréciation n'existe."
    },
    {
      "name": "03 - Note invalide > 5 (400 Bad Request + Problem Details)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Content-Type is problem+json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "});",
              "pm.test(\"Problem details structure\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.type).to.eql(\"about:blank\");",
              "    pm.expect(json.status).to.eql(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"authorName\": \"Samira\",\n  \"rating\": 6,\n  \"comment\": \"Très bien mais note trop haute\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/places/{{placeId}}/reviews",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "places",
            "{{placeId}}",
            "reviews"
          ]
        }
      },
      "description": "Publier une appréciation avec une note de 9 : 400 Bad Request au format application/problem+json."
    },
